<odoo>
    <record id="privilege_office" model="res.groups.privilege">
        <field name="name">显微镜企业办公</field>
        <field name="category_id" ref="base.module_category_productivity"/>
        <field name="sequence">5</field>
    </record>
    <record id="group_staff" model="res.groups">
        <field name="name">普通员工</field>
        <field name="privilege_id" ref="privilege_office"/>
        <field name="sequence">10</field>
        <field name="implied_ids" eval="[(4, ref('base.group_user')), (4, ref('project.group_project_user'))]"/>
    </record>
    <record id="group_procurement" model="res.groups">
        <field name="name">采购</field>
        <field name="privilege_id" ref="privilege_office"/>
        <field name="sequence">20</field>
        <field name="implied_ids" eval="[(4, ref('group_staff')), (4, ref('purchase.group_purchase_user')), (4, ref('base.group_partner_manager'))]"/>
    </record>
    <record id="group_manager" model="res.groups">
        <field name="name">负责人</field>
        <field name="privilege_id" ref="privilege_office"/>
        <field name="sequence">30</field>
        <field name="implied_ids" eval="[(4, ref('group_procurement')), (4, ref('purchase.group_purchase_manager')), (4, ref('project.group_project_manager'))]"/>
    </record>
    <record id="group_admin" model="res.groups">
        <field name="name">系统管理员</field>
        <field name="privilege_id" ref="privilege_office"/>
        <field name="sequence">40</field>
        <field name="implied_ids" eval="[(4, ref('group_manager')), (4, ref('base.group_system')), (4, ref('hr.group_hr_manager'))]"/>
        <field name="user_ids" eval="[(4, ref('base.user_root')), (4, ref('base.user_admin'))]"/>
    </record>
</odoo>
